C++ Codes for Array Operations, Sorting & Searching

These are the standard C++ implementations commonly expected in DSA exams and interviews.

1. Array Traversal

Purpose: Visit every element of the array once.

#include <iostream>
using namespace std;


int main() {
    int arr[] = {10, 20, 30, 40, 50};
    int n = 5;


    for(int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
}

Time: O(n) Space: O(1)

2. Array Insertion

Insert an element at a given position

#include <iostream>
using namespace std;


int main() {
    int arr[100] = {10, 20, 30, 40};
    int n = 4;


    int pos = 2;      // Insert at index 2
    int value = 25;


    for(int i = n; i > pos; i--) {
        arr[i] = arr[i - 1];
    }


    arr[pos] = value;
    n++;


    for(int i = 0; i < n; i++)
        cout << arr[i] << " ";
}

Output

10 20 25 30 40

Time: O(n) Space: O(1)

3. Array Deletion

Delete an element from a given position

#include <iostream>
using namespace std;


int main() {
    int arr[100] = {10, 20, 30, 40, 50};
    int n = 5;


    int pos = 2;      // Delete index 2


    for(int i = pos; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }


    n--;


    for(int i = 0; i < n; i++)
        cout << arr[i] << " ";
}

Output

10 20 40 50

Time: O(n) Space: O(1)

4. Bubble Sort

Idea: Compare adjacent elements and swap them.

#include <iostream>
using namespace std;


int main() {
    int arr[] = {5, 1, 4, 2, 8};
    int n = 5;


    for(int i = 0; i < n - 1; i++) {
        for(int j = 0; j < n - i - 1; j++) {
            if(arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
            }
        }
    }


    for(int x : arr)
        cout << x << " ";
}

Output

1 2 4 5 8

Best O(n)

	

Average O(n²)

	

Worst O(n²)

5. Insertion Sort

Idea: Insert each element into its correct sorted position.

#include <iostream>
using namespace std;


int main() {
    int arr[] = {5, 2, 4, 6, 1};
    int n = 5;


    for(int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;


        while(j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }


        arr[j + 1] = key;
    }


    for(int x : arr)
        cout << x << " ";
}

Output

1 2 4 5 6

Best O(n)

	

Average O(n²)

	

Worst O(n²)


6. Selection Sort

Idea: Find the smallest element and place it at the beginning.

#include <iostream>
using namespace std;


int main() {
    int arr[] = {64, 25, 12, 22, 11};
    int n = 5;


    for(int i = 0; i < n - 1; i++) {
        int minIndex = i;


        for(int j = i + 1; j < n; j++) {
            if(arr[j] < arr[minIndex])
                minIndex = j;
        }


        swap(arr[i], arr[minIndex]);
    }


    for(int x : arr)
        cout << x << " ";
}

Output

11 12 22 25 64

Time: O(n²) Space: O(1)

7. Linear Search

Idea: Check every element one by one.

#include <iostream>
using namespace std;


int main() {
    int arr[] = {10, 20, 30, 40, 50};
    int n = 5;
    int target = 30;


    for(int i = 0; i < n; i++) {
        if(arr[i] == target) {
            cout << "Found at index " << i;
            return 0;
        }
    }


    cout << "Not Found";
}

Output

Found at index 2

Best O(1)

Average O(n)
	
Worst O(n)

8. Binary Search

Condition: Array must be sorted.

#include <iostream>
using namespace std;


int main() {
    int arr[] = {10, 20, 30, 40, 50, 60, 70};
    int n = 7;
    int target = 50;


    int low = 0, high = n - 1;


    while(low <= high) {
        int mid = (low + high) / 2;


        if(arr[mid] == target) {
            cout << "Found at index " << mid;
            return 0;
        }
        else if(arr[mid] < target)
            low = mid + 1;
        else
            high = mid - 1;
    }


    cout << "Not Found";
}

Output

Found at index 4

Best - O(1)

	

Average - O(log n)

	

Worst - O(log n)


9. Merge Two Sorted Arrays

Idea: Compare elements of both arrays and store the smaller one.

#include <iostream>
using namespace std;


int main() {
    int a[] = {1, 3, 5};
    int b[] = {2, 4, 6};


    int n = 3, m = 3;
    int c[6];


    int i = 0, j = 0, k = 0;


    while(i < n && j < m) {
        if(a[i] < b[j])
            c[k++] = a[i++];
        else
            c[k++] = b[j++];
    }


    while(i < n)
        c[k++] = a[i++];


    while(j < m)
        c[k++] = b[j++];


    for(int x = 0; x < n + m; x++)
        cout << c[x] << " ";
}

Output

1 2 3 4 5 6

Time: O(n + m) Space: O(n + m)
